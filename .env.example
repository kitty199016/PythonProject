# ============================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ============================================

# Режим работы приложения (development, production, test)
NODE_ENV=development

# Порт сервера
PORT=3000

# Хост сервера
HOST=localhost


# ============================================
# API КЛЮЧИ И ТОКЕНЫ ДОСТУПА
# ============================================

# API ключ для сервиса (пример)
API_KEY=your_api_key_here

# Секретный ключ для JWT
JWT_SECRET=your_jwt_secret_key_here

# Токен доступа к внешнему API
ACCESS_TOKEN=your_access_token_here

# Refresh токен (если используется)
REFRESH_TOKEN=your_refresh_token_here


# ============================================
# НАСТРОЙКИ БАЗЫ ДАННЫХ
# ============================================

# URL подключения к базе данных (пример для PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Для MongoDB
# MONGODB_URI=mongodb://user:password@localhost:27017/dbname


# ============================================
# НАСТРОЙКИ REDIS (если используется)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here


# ============================================
# НАСТРОЙКИ SMTP (для отправки писем)
# ============================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password_here


# ============================================
# ВНЕШНИЕ СЕРВИСЫ
# ============================================

# Сторонний сервис (пример)
SERVICE_API_URL=https://api.example.com
SERVICE_API_KEY=your_service_api_key_here


# ============================================
# НАСТРОЙКИ БЕЗОПАСНОСТИ
# ============================================

# Соль для хеширования паролей
SALT_ROUNDS=10

# Время жизни токена (в секундах)
TOKEN_EXPIRY=86400


# ============================================
# ЛОГИРОВАНИЕ
# ============================================

# Уровень логирования (error, warn, info, debug)
LOG_LEVEL=info


# ============================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ============================================

# Язык интерфейса
LANG=ru

# Часовой пояс
TIMEZONE=Europe/Moscow
